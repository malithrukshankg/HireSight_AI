# Copy to .env for local development (optional; defaults match localhost).

# Logical service name (health/metadata; optional override)
# SERVICE_NAME=agent-service

# cv-service base URL (internal HTTP). Docker Compose: http://cv-service:8001
CV_SERVICE_URL=http://localhost:8001

# api-gateway base URL for future internal job/context calls. Docker Compose: http://api-gateway:8000
GATEWAY_SERVICE_URL=http://localhost:8000

# httpx timeout for outbound service calls (seconds)
HTTP_TIMEOUT_SECONDS=30
